---
import Layout from '../layouts/Layout.astro';
import Cursor from '../components/Cursor.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Certifications from '../components/sections/Certifications.astro';
import Arsenal from '../components/sections/Arsenal.astro';
import Projects from '../components/sections/Projects.astro';
import Infrastructure from '../components/sections/Infrastructure.astro';
import Connect from '../components/sections/Connect.astro';
---

<Layout title="Oussama Karem | SysOps Engineer">
    <Cursor />
    
    <main class="max-w-screen-2xl mx-auto px-6 md:px-16 py-12 md:py-20">
        <Hero />
        <About />
        <Certifications />
        <Arsenal />
        <Projects />
        <Infrastructure />
        <Connect />
    </main>
</Layout>

<script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    gsap.fromTo(".hero-name-1", 
        { y: 80, autoAlpha: 0 }, 
        { y: 0, autoAlpha: 1, duration: 0.8, ease: "power4.out", delay: 2.8 }
    );
    gsap.fromTo(".hero-name-2", 
        { y: 80, autoAlpha: 0 }, 
        { y: 0, autoAlpha: 0.5, duration: 0.8, ease: "power4.out", delay: 3.0 }
    );

    gsap.from(".reveal-content", { 
        scrollTrigger: { trigger: ".reveal-content", start: "top 95%" }, 
        y: 40, autoAlpha: 0, duration: 1, stagger: 0.2, ease: "power2.out" 
    });
</script>
