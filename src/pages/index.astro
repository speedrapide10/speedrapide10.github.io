---
import Layout from '../layouts/Layout.astro';
import Cursor from '../components/Cursor.astro';
import { Terminal, Cpu, Cloud } from 'lucide-react';

/* Oussama Karem | SysOps L2 Engineer 
   - RED HAT: DEFINITIVE FIX (Exact path provided by user)
   - NAVIGATION: Integrated IDs for menu
   - TYPOGRAPHY: Muted OUSSAMA, 50% opacity KAREM
*/
---

<Layout title="Oussama Karem | SysOps L2 Engineer">
    <Cursor />
    
    <main class="max-w-6xl mx-auto px-6 md:px-12 py-32">
        
        <section class="min-h-[70vh] flex flex-col justify-center items-start">
            <div class="reveal-hero w-full">
                <div class="overflow-hidden mb-4">
                    <p class="font-mono text-blue-600 dark:text-blue-400 text-sm tracking-[0.5em] uppercase font-bold">
                        Ingénieur SysOps N2
                    </p>
                </div>
                
                <div class="relative">
                    <h1 class="text-7xl md:text-[11rem] font-black tracking-tighter leading-[0.75] uppercase select-none text-zinc-800 dark:text-zinc-300">
                        OUSSAMA
                    </h1>
                    <h1 class="text-7xl md:text-[11rem] font-black leading-[0.75] uppercase text-transparent outline-name opacity-50 hover:opacity-100 transition-all duration-1000 cursor-default ml-2 md:ml-6 mt-2">
                        KAREM
                    </h1>
                </div>

                <div class="mt-16 flex flex-wrap gap-x-12 gap-y-6 font-mono text-xs uppercase tracking-[0.25em] opacity-90">
                    <span class="flex items-center gap-3 font-bold visible-primary border-l-2 border-blue-500 pl-4">
                        <Cpu size={18} client:load /> Linux Specialist
                    </span>
                    <span class="flex items-center gap-3 font-bold visible-primary border-l-2 border-zinc-500/30 pl-4">
                        <Terminal size={18} client:load /> Automation Expert
                    </span>
                    <span class="flex items-center gap-3 font-bold visible-primary border-l-2 border-zinc-500/30 pl-4">
                        <Cloud size={18} client:load /> Cloud Native Architect
                    </span>
                </div>
            </div>
        </section>

        <section id="credentials" class="py-24 border-y border-zinc-500/20 dark:border-white/10 reveal-content">
            <h2 class="text-xs font-bold tracking-[0.5em] uppercase opacity-60 mb-12 italic visible-primary">/ Professional_Credentials</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                
                <div class="flex items-center gap-5 p-6 bg-card-bg border border-zinc-400/30 dark:border-white/10 rounded-2xl hover:border-[#EE0000] transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" class="w-12 h-12 fill-[#EE0000]">
                        <path d="M405.5 349.6C439.2 349.6 487.8 342.7 487.8 302.6C488 295.9 488.7 300.8 466.9 206.4C462.3 187.3 458.2 178.6 424.6 161.8C398.5 148.5 341.7 126.4 324.9 126.4C309.2 126.4 304.7 146.6 286 146.6C268 146.6 254.7 131.5 237.9 131.5C221.8 131.5 211.2 142.5 203.1 165.1C175.6 242.7 176.8 239.4 177 243.4C177 268.2 274.6 349.5 405.5 349.5zM493 318.8C497.7 340.8 497.7 343.1 497.7 346C497.7 383.7 455.4 404.6 399.7 404.6C274 404.7 163.8 331 163.8 282.3C163.8 275.5 165.2 268.8 167.9 262.6C122.7 264.9 64.1 272.9 64.1 324.6C64.1 409.3 264.7 513.6 423.6 513.6C545.4 513.6 576.1 458.5 576.1 415C576.1 380.8 546.5 342 493.2 318.8z"/>
                    </svg>
                    <div>
                        <p class="text-sm font-bold tracking-widest uppercase visible-primary">RHCSA</p>
                        <p class="text-[11px] font-mono uppercase visible-secondary">Red Hat Certified</p>
                    </div>
                </div>

                <div class="flex items-center gap-5 p-6 bg-card-bg border border-zinc-400/30 dark:border-white/10 rounded-2xl hover:border-[#EE3124] transition-all">
                    <svg viewBox="0 0 24 24" class="w-12 h-12 fill-[#EE3124]">
                        <path d="M0 9.785h6.788v4.454H0zm8.666-6.33h6.668v4.453H8.666zm0 12.637h6.668v4.454H8.666zm8.522-6.307H24v4.454h-6.812zM2.792 3.455C1.372 3.814.265 5.404 0 7.425v.506h6.788V3.454zM0 16.091v.554c.24 1.926 1.276 3.466 2.624 3.9h4.188v-4.454zm24-8.184v-.506c-.265-1.998-1.372-3.587-2.792-3.972h-4.02v4.454H24zM21.376 20.57c1.324-.458 2.36-1.974 2.624-3.9v-.554h-6.812v4.454Z"/>
                    </svg>
                    <div>
                        <p class="text-sm font-bold tracking-widest uppercase visible-primary">NSE</p>
                        <p class="text-[11px] font-mono uppercase visible-secondary">Fortinet Certified</p>
                    </div>
                </div>

                <div class="flex items-center gap-5 p-6 bg-card-bg border border-zinc-400/30 dark:border-white/10 rounded-2xl hover:border-[#F26D21] transition-all">
                    <svg viewBox="0 0 24 24" class="w-12 h-12 fill-[#F26D21]">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15l-5-5 1.41-1.41L11 14.17l7.59-7.59L20 8l-9 9z"/>
                    </svg>
                    <div>
                        <p class="text-sm font-bold tracking-widest uppercase visible-primary">Scrum SFC</p>
                        <p class="text-[11px] font-mono uppercase visible-secondary">SCRUMstudy Certified</p>
                    </div>
                </div>

                <div class="flex items-center gap-5 p-6 bg-card-bg border border-zinc-400/30 dark:border-white/10 rounded-2xl hover:border-[#0073B1] transition-all">
                    <div class="w-12 h-12 bg-[#0073B1] rounded flex items-center justify-center font-black text-white text-xl italic">EF</div>
                    <div>
                        <p class="text-sm font-bold tracking-widest uppercase visible-primary">EF SET</p>
                        <p class="text-[11px] font-mono uppercase visible-secondary">English B2 Upper Intermediate</p>
                    </div>
                </div>
            </div>
        </section>

        <div id="experience" class="grid grid-cols-1 lg:grid-cols-12 gap-24 py-24">
            <div class="lg:col-span-8 space-y-24">
                <h2 class="text-xs font-bold tracking-[0.5em] uppercase opacity-50 mb-12 visible-primary">/ Experience</h2>
                
                <article class="relative pl-12 reveal-content">
                    <div class="absolute w-4 h-4 bg-blue-500 rounded-full -left-[8px] top-2 shadow-lg shadow-blue-500/20"></div>
                    <header class="mb-10">
                        <h3 class="text-4xl font-bold uppercase tracking-tight visible-primary">Ingénieur SysOps N2</h3>
                        <p class="text-xs font-mono text-blue-600 dark:text-blue-400 uppercase tracking-widest mt-3 italic font-bold">
                            Alter Way, a Smile Group Company | 2025 — Present
                        </p>
                    </header>
                    <ul class="text-base space-y-4 visible-secondary border-l-2 border-zinc-500/20 dark:border-white/10 pl-10 font-medium">
                        <li>• Gestion et résolution des tickets N2/N3 et engagements SLA.</li>
                        <li>• Automatisation des déploiements via Ansible et GitLab CI.</li>
                        <li>• Administration Proxmox, oVirt, Docker et Podman.</li>
                        <li>• Sécurisation via Cloudflare CDN/WAF.</li>
                    </ul>
                </article>

                <article class="relative pl-12 reveal-content">
                    <div class="absolute w-3 h-3 bg-zinc-400 dark:bg-zinc-600 rounded-full -left-[5.5px] top-2"></div>
                    <header class="mb-8">
                        <h3 class="text-3xl font-bold opacity-80 uppercase tracking-tight visible-primary">System Operations Analyst</h3>
                        <p class="text-xs font-mono opacity-50 uppercase tracking-widest mt-2 visible-secondary">
                            Capgemini | 2024 — 2025
                        </p>
                    </header>
                    <p class="text-base visible-secondary pl-10 leading-relaxed">
                        Administration d'infrastructures IT hybrides et automatisation via Power Automate.
                    </p>
                </article>
            </div>

            <div id="education" class="lg:col-span-4 space-y-20">
                <section class="reveal-content">
                    <h2 class="text-xs font-bold tracking-[0.5em] uppercase opacity-50 mb-12 visible-primary">/ Academic_Path</h2>
                    <div class="space-y-16">
                        <div>
                            <p class="font-bold text-2xl italic leading-tight visible-primary">Master MISRS</p>
                            <p class="text-xs font-mono opacity-60 mt-2 uppercase visible-secondary">FST Settat | 2022</p>
                        </div>
                        <div>
                            <p class="font-bold text-2xl italic leading-tight visible-primary">Licence LISRS</p>
                            <p class="text-xs font-mono opacity-60 mt-2 uppercase visible-secondary">FST Settat | 2021</p>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </main>
</Layout>

<style>
    .outline-name {
        -webkit-text-stroke: 1px var(--foreground);
    }
    /* Smooth scroll for navigation */
    html {
        scroll-behavior: smooth;
    }
</style>

<script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    gsap.from(".reveal-hero h1", { 
        y: 100, 
        opacity: 0, 
        duration: 1.2, 
        stagger: 0.2, 
        ease: "expo.out" 
    });
    
    gsap.from(".reveal-content", {
        scrollTrigger: { trigger: ".reveal-content", start: "top 95%" },
        y: 40, opacity: 0, duration: 1, stagger: 0.2, ease: "power2.out"
    });
</script>