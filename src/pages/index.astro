---
/** * IMPORTS: Essential tools for icons and layout components. */
import Layout from '../layouts/Layout.astro';
import Cursor from '../components/Cursor.astro';
import { 
    Terminal, Cpu, Cloud, Shield, Activity, 
    Network, Github, Linkedin, ExternalLink, 
    Code2, RefreshCw, Lock, Heart, Box, Layers, FileDown
} from 'lucide-react';

/* ==========================================================
   RESUME CONFIGURATION
   ========================================================== */
const RESUME_PATH = "#"; 
const LINKEDIN_URL = "https://linkedin.com/in/oussama-karem";
const CV_LINK = RESUME_PATH === "#" ? LINKEDIN_URL : RESUME_PATH;

/* Oussama Karem | SysOps Engineer
   -------------------------------------------------
   TECHNICAL DATA PRESERVATION:
   - Red Hat: Exact 640x640 path provided (#EE0000)
   - English: B2 Upper Intermediate Level
   - Projects: OPNSense & Ansible Security Patches included.
*/
---

<Layout title="Oussama Karem | SysOps Engineer">
    <Cursor />
    
    <main class="max-w-screen-2xl mx-auto px-6 md:px-16 py-12 md:py-20">
        
        <section class="min-h-[85vh] flex flex-col justify-center items-start">
            <div class="reveal-hero w-full">
                <p class="font-mono text-blue-600 dark:text-blue-400 text-sm md:text-base tracking-[0.3em] md:tracking-[0.5em] uppercase font-bold mb-6">
                    SysOps Engineer
                </p>

                <div class="relative min-h-[110px] sm:min-h-[160px] lg:min-h-0">
                    <h1 class="text-6xl sm:text-7xl lg:text-[9rem] xl:text-[11rem] 2xl:text-[13rem] font-black tracking-tighter leading-[0.75] uppercase select-none text-foreground opacity-0 hero-name-1">
                        OUSSAMA
                    </h1>
                    <h1 class="text-6xl sm:text-7xl lg:text-[9rem] xl:text-[11rem] 2xl:text-[13rem] font-black leading-[0.75] uppercase text-transparent outline-name opacity-0 hover:opacity-100 transition-all duration-1000 cursor-default md:ml-8 mt-2 hero-name-2">
                        KAREM
                    </h1>
                </div>
                
                <div class="mt-12 md:mt-20 flex flex-wrap gap-x-8 md:gap-x-16 gap-y-6 md:gap-y-8 font-mono text-xs md:text-sm uppercase tracking-widest">
                    <span class="flex items-center gap-3 md:gap-4 font-bold visible-primary border-l-4 border-blue-500 pl-4 md:pl-6"><Cpu size={18} client:load /> Linux Specialist</span>
                    <span class="flex items-center gap-3 md:gap-4 font-bold visible-primary border-l-4 border-zinc-700 pl-4 md:pl-6"><Terminal size={18} client:load /> IaC & Automation</span>
                    <span class="flex items-center gap-3 md:gap-4 font-bold visible-primary border-l-4 border-zinc-700 pl-4 md:pl-6"><Box size={18} client:load /> Virtualization Specialist</span>
                </div>

                <div class="mt-12 md:mt-16 flex flex-col sm:flex-row gap-4 md:gap-6">
                    <a href={CV_LINK} target="_blank" class="flex justify-center items-center gap-3 px-8 py-4 bg-blue-600 text-white rounded-xl font-bold hover:scale-105 transition-all shadow-xl shadow-blue-600/20">
                        <FileDown size={20} /> Download CV
                    </a>
                    <div class="flex gap-4">
                        <a href="https://linkedin.com/in/oussama-karem" target="_blank" class="flex-1 flex justify-center items-center gap-3 px-6 py-4 bg-[#0077b5] text-white rounded-xl font-bold hover:scale-105 transition-all">
                            <Linkedin size={20} /> LinkedIn
                        </a>
                        <a href="https://github.com/speedrapide10" target="_blank" class="flex-1 flex justify-center items-center gap-3 px-6 py-4 bg-zinc-900 dark:bg-zinc-100 dark:text-zinc-900 text-white rounded-xl font-bold hover:scale-105 transition-all">
                            <Github size={20} /> GitHub
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <section id="about" class="pt-10 pb-24 md:pt-14 md:pb-32 border-t border-zinc-500/20 dark:border-white/10 reveal-content scroll-mt-28">
            <div class="max-w-5xl">
                <h2 class="text-xs md:text-sm font-bold tracking-[0.5em] md:tracking-[0.6em] uppercase opacity-60 mb-8 md:mb-12 italic visible-primary">/ Core_Philosophy</h2>
                <div class="space-y-8 md:space-y-10">
                    <p class="text-2xl md:text-5xl font-medium leading-tight visible-primary tracking-tight">
                        Passionate SysOps Engineer specialized in the <span class="text-blue-500 font-bold">Linux ecosystem</span>. 
                        I build infrastructure that scales with ease and runs without friction.
                    </p>
                    <p class="text-lg md:text-2xl visible-secondary leading-relaxed max-w-4xl font-medium">
                        I leverage <span class="text-foreground font-bold border-b-2 border-blue-500/30">Ansible</span> and <span class="text-foreground font-bold border-b-2 border-orange-500/30">Terraform</span> to treat infrastructure as code—ensuring perfect server configurations, automated package management, and reproducible environments across <span class="font-bold">Proxmox</span> and <span class="font-bold">Docker</span>.
                    </p>
                    <div class="relative pl-6 md:pl-10 border-l-4 border-blue-500 py-6 glass-card rounded-r-2xl md:rounded-r-3xl group transition-all hover:bg-blue-500/5">
                        <Heart size={20} class="absolute -left-3 top-0 text-blue-500 bg-background rounded-full p-0.5" />
                        <p class="text-xl md:text-3xl italic visible-primary opacity-90 leading-relaxed">
                            "While I am an expert in <span class="text-blue-500">Bash and Python</span> for custom logic, my heart is in total **Automation**. I use IaC to make complex systems predictable and life fundamentally <span class="underline decoration-blue-500/40">much more easier</span> for everyone."
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <section id="certifications" class="pt-10 pb-24 md:pt-14 md:pb-32 border-t border-zinc-500/20 dark:border-white/10 reveal-content scroll-mt-28">
            <h2 class="text-xs md:text-sm font-bold tracking-[0.5em] md:tracking-[0.6em] uppercase opacity-60 mb-12 md:mb-16 italic visible-primary">/ Certifications</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
                <div class="group flex items-center gap-6 p-6 md:p-8 glass-card rounded-3xl hover:border-[#EE0000] hover:shadow-[0_0_30px_rgba(238,0,0,0.1)] transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" class="w-12 h-12 md:w-14 md:h-14 fill-[#EE0000]">
                        <path d="M405.5 349.6C439.2 349.6 487.8 342.7 487.8 302.6C488 295.9 488.7 300.8 466.9 206.4C462.3 187.3 458.2 178.6 424.6 161.8C398.5 148.5 341.7 126.4 324.9 126.4C309.2 126.4 304.7 146.6 286 146.6C268 146.6 254.7 131.5 237.9 131.5C221.8 131.5 211.2 142.5 203.1 165.1C175.6 242.7 176.8 239.4 177 243.4C177 268.2 274.6 349.5 405.5 349.5zM493 318.8C497.7 340.8 497.7 343.1 497.7 346C497.7 383.7 455.4 404.6 399.7 404.6C274 404.7 163.8 331 163.8 282.3C163.8 275.5 165.2 268.8 167.9 262.6C122.7 264.9 64.1 272.9 64.1 324.6C64.1 409.3 264.7 513.6 423.6 513.6C545.4 513.6 576.1 458.5 576.1 415C576.1 380.8 546.5 342 493.2 318.8z"/>
                    </svg>
                    <div><p class="text-sm md:text-base font-bold uppercase visible-primary">RHCSA</p><p class="text-[10px] md:text-xs font-mono uppercase visible-secondary">Red Hat Certified</p></div>
                </div>
                <div class="group flex items-center gap-6 p-6 md:p-8 glass-card rounded-3xl hover:border-[#EE3124] transition-all">
                    <svg viewBox="0 0 24 24" class="w-12 h-12 md:w-14 md:h-14 fill-[#EE3124]"><path d="M0 9.785h6.788v4.454H0zm8.666-6.33h6.668v4.453H8.666zm0 12.637h6.668v4.454H8.666zm8.522-6.307H24v4.454h-6.812zM2.792 3.455C1.372 3.814.265 5.404 0 7.425v.506h6.788V3.454zM0 16.091v.554c.24 1.926 1.276 3.466 2.624 3.9h4.188v-4.454zm24-8.184v-.506c-.265-1.998-1.372-3.587-2.792-3.972h-4.02v4.454H24zM21.376 20.57c1.324-.458 2.36-1.974 2.624-3.9v-.554h-6.812v4.454Z"/></svg>
                    <div><p class="text-sm md:text-base font-bold uppercase visible-primary">NSE</p><p class="text-[10px] md:text-xs font-mono uppercase visible-secondary">Fortinet Certified</p></div>
                </div>
                <div class="group flex items-center gap-6 p-6 md:p-8 glass-card rounded-3xl hover:border-[#F26D21] transition-all">
                    <svg viewBox="0 0 24 24" class="w-12 h-12 md:w-14 md:h-14 fill-[#F26D21]"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15l-5-5 1.41-1.41L11 14.17l7.59-7.59L20 8l-9 9z"/></svg>
                    <div><p class="text-sm md:text-base font-bold uppercase visible-primary">Scrum SFC</p><p class="text-[10px] md:text-xs font-mono uppercase visible-secondary">SCRUMstudy Certified</p></div>
                </div>
                <div class="group flex items-center gap-6 p-6 md:p-8 glass-card rounded-3xl hover:border-[#0073B1] transition-all">
                    <div class="w-12 h-12 md:w-14 md:h-14 bg-[#0073B1] rounded-xl flex items-center justify-center font-black text-white text-xl md:text-2xl italic">EF</div>
                    <div><p class="text-sm md:text-base font-bold uppercase visible-primary">EF SET</p><p class="text-[10px] md:text-xs font-mono uppercase visible-secondary">English B2 Upper Intermediate</p></div>
                </div>
            </div>
        </section>

        <section id="arsenal" class="pt-10 pb-24 md:pt-14 md:pb-32 border-t border-zinc-500/20 dark:border-white/10 reveal-content scroll-mt-28">
            <h2 class="text-xs md:text-sm font-bold tracking-[0.5em] md:tracking-[0.6em] uppercase opacity-60 mb-12 md:mb-16 italic visible-primary">/ Technical_Arsenal</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-12">
                <div class="p-8 md:p-10 glass-card rounded-3xl space-y-4 md:space-y-6">
                    <div class="flex items-center gap-4 text-blue-500"><Terminal size={22} /> <h3 class="font-bold uppercase tracking-widest text-xs md:text-sm">IaC & Automation</h3></div>
                    <p class="text-sm visible-secondary leading-relaxed font-medium">Terraform (Provisioning), Ansible (Automated Server Config, Package Management, Security Hardening).</p>
                </div>
                <div class="p-8 md:p-10 glass-card rounded-3xl space-y-4 md:space-y-6">
                    <div class="flex items-center gap-4 text-orange-500"><Cpu size={22} /> <h3 class="font-bold uppercase tracking-widest text-xs md:text-sm">Advanced Scripting</h3></div>
                    <p class="text-sm visible-secondary leading-relaxed font-medium">Expert-level Bash automation and Python development for custom system tools and workflow optimization.</p>
                </div>
                <div class="p-8 md:p-10 glass-card rounded-3xl space-y-4 md:space-y-6">
                    <div class="flex items-center gap-4 text-green-500"><Activity size={22} /> <h3 class="font-bold uppercase tracking-widest text-xs md:text-sm">Observability</h3></div>
                    <p class="text-sm visible-secondary leading-relaxed font-medium">Zabbix, Nagios Core, Prometheus, Grafana Dashboards, ELK Stack (Log Management).</p>
                </div>
                <div class="p-8 md:p-10 glass-card rounded-3xl space-y-4 md:space-y-6">
                    <div class="flex items-center gap-4 text-zinc-500 dark:text-zinc-400"><Layers size={22} /> <h3 class="font-bold uppercase tracking-widest text-xs md:text-sm">Operating Systems</h3></div>
                    <p class="text-sm visible-secondary leading-relaxed font-medium">RHEL (Red Hat Enterprise Linux), CentOS, Debian GNU/Linux, Ubuntu Server, Windows Server AD.</p>
                </div>
                <div class="p-8 md:p-10 glass-card rounded-3xl space-y-4 md:space-y-6">
                    <div class="flex items-center gap-4 text-purple-500"><Network size={22} /> <h3 class="font-bold uppercase tracking-widest text-xs md:text-sm">Networking</h3></div>
                    <p class="text-sm visible-secondary leading-relaxed font-medium">Cisco IOS, MikroTik RouterOS, OPNSense Firewall, TCP/IP, VLAN Segmentation, VPN (WireGuard/OpenVPN).</p>
                </div>
                <div class="p-8 md:p-10 glass-card rounded-3xl space-y-4 md:space-y-6">
                    <div class="flex items-center gap-4 text-red-500"><Shield size={22} /> <h3 class="font-bold uppercase tracking-widest text-sm text-xs md:text-sm">Cyber Security</h3></div>
                    <p class="text-sm visible-secondary leading-relaxed font-medium">Fortinet NSE standards, OPNSense Protection, SSH Hardening, SSL/TLS Lifecycle, Cloudflare WAF.</p>
                </div>
            </div>
        </section>

        <section id="projects" class="pt-10 pb-24 md:pt-14 md:pb-32 border-t border-zinc-500/20 dark:border-white/10 reveal-content scroll-mt-28">
            <h2 class="text-xs md:text-sm font-bold tracking-[0.5em] md:tracking-[0.6em] uppercase opacity-60 mb-12 md:mb-16 italic visible-primary">/ Featured_Projects</h2>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12">
                <div class="group p-6 md:p-10 glass-card rounded-2xl md:rounded-[2.5rem] flex flex-col justify-between">
                    <div>
                        <div class="flex justify-between items-start mb-6 md:mb-8">
                            <div class="p-4 bg-blue-500/10 rounded-xl text-blue-500"><Code2 size={24} md:size={32} /></div>
                            <ExternalLink size={20} class="opacity-20 group-hover:opacity-100 transition-opacity" />
                        </div>
                        <h3 class="text-2xl md:text-3xl font-bold uppercase tracking-tight mb-4 visible-primary transition-all">Ansible Fleet Security</h3>
                        <p class="text-base md:text-lg visible-secondary leading-relaxed mb-6 md:mb-8">Automating the deployment of critical security patches and OS hardening policies across mixed RHEL and Debian environments using idempotent playbooks.</p>
                    </div>
                    <div class="flex gap-2 flex-wrap">
                        <span class="px-3 py-1.5 bg-zinc-200 dark:bg-zinc-800 rounded-full text-[10px] font-bold uppercase tracking-widest">Ansible</span>
                        <span class="px-3 py-1.5 bg-zinc-200 dark:bg-zinc-800 rounded-full text-[10px] font-bold uppercase tracking-widest">Security</span>
                        <span class="px-3 py-1.5 bg-zinc-200 dark:bg-zinc-800 rounded-full text-[10px] font-bold uppercase tracking-widest">RHEL</span>
                    </div>
                </div>
                <div class="group p-6 md:p-10 glass-card rounded-2xl md:rounded-[2.5rem] flex flex-col justify-between">
                    <div>
                        <div class="flex justify-between items-start mb-6 md:mb-8">
                            <div class="p-4 bg-orange-500/10 rounded-xl text-orange-500"><Shield size={24} md:size={32} /></div>
                            <ExternalLink size={20} class="opacity-20 group-hover:opacity-100 transition-opacity" />
                        </div>
                        <h3 class="text-2xl md:text-3xl font-bold uppercase tracking-tight mb-4 visible-primary transition-all">Cloudflare IaC Security</h3>
                        <p class="text-base md:text-lg visible-secondary leading-relaxed mb-6 md:mb-8">Managing global edge security using Terraform to automate Cloudflare WAF rules, DNS zones, and Zero Trust access policies with version-controlled safety.</p>
                    </div>
                    <div class="flex gap-2 flex-wrap">
                        <span class="px-3 py-1.5 bg-zinc-200 dark:bg-zinc-800 rounded-full text-[10px] font-bold uppercase tracking-widest">Terraform</span>
                        <span class="px-3 py-1.5 bg-zinc-200 dark:bg-zinc-800 rounded-full text-[10px] font-bold uppercase tracking-widest">Cloudflare</span>
                        <span class="px-3 py-1.5 bg-zinc-200 dark:bg-zinc-800 rounded-full text-[10px] font-bold uppercase tracking-widest">IaC</span>
                    </div>
                </div>
                <div class="group p-6 md:p-10 glass-card rounded-2xl md:rounded-[2.5rem] flex flex-col justify-between">
                    <div>
                        <div class="flex justify-between items-start mb-6 md:mb-8">
                            <div class="p-4 bg-green-500/10 rounded-xl text-green-500"><Lock size={24} md:size={32} /></div>
                            <ExternalLink size={20} class="opacity-20 group-hover:opacity-100 transition-opacity" />
                        </div>
                        <h3 class="text-2xl md:text-3xl font-bold uppercase tracking-tight mb-4 visible-primary transition-all">OPNSense Virtual Security</h3>
                        <p class="text-base md:text-lg visible-secondary leading-relaxed mb-6 md:mb-8">Deploying and orchestrating OPNSense firewalls within Proxmox clusters to secure internal VM traffic and automate site-to-site VPN tunnels.</p>
                    </div>
                    <div class="flex gap-2 flex-wrap">
                        <span class="px-3 py-1.5 bg-zinc-200 dark:bg-zinc-800 rounded-full text-[10px] font-bold uppercase tracking-widest">OPNSense</span>
                        <span class="px-3 py-1.5 bg-zinc-200 dark:bg-zinc-800 rounded-full text-[10px] font-bold uppercase tracking-widest">Proxmox</span>
                        <span class="px-3 py-1.5 bg-zinc-200 dark:bg-zinc-800 rounded-full text-[10px] font-bold uppercase tracking-widest">Firewall</span>
                    </div>
                </div>
                <div class="group p-6 md:p-10 glass-card border-dashed animate-learning-pulse rounded-2xl md:rounded-[2.5rem] flex flex-col justify-center text-center">
                    <div class="flex flex-col items-center">
                        <RefreshCw size={32} md:size={40} class="text-blue-500 mb-4 animate-spin-slow" />
                        <h3 class="text-xl md:text-2xl font-bold uppercase tracking-tight mb-2 visible-primary">Learning New Tech</h3>
                        <p class="text-base md:text-lg visible-secondary italic leading-relaxed">
                            "Currently exploring Kubernetes orchestration, Advanced CI/CD patterns, and Go-based system tools. Always evolving."
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <section id="connect" class="pt-10 pb-40 md:pt-40 reveal-content scroll-mt-28">
            <div class="max-w-4xl mx-auto text-center space-y-8 md:space-y-12 pb-20">
                <h2 class="text-4xl md:text-7xl font-black uppercase tracking-tighter visible-primary">Scale with confidence.</h2>
                <p class="text-xl md:text-2xl visible-secondary leading-relaxed px-4">
                    Explore my full professional experience and code contributions.
                </p>
                <div class="flex flex-col sm:flex-row justify-center gap-6 md:gap-8 pt-8 px-6 pb-12">
                    <a href="https://linkedin.com/in/oussama-karem" target="_blank" class="flex justify-center items-center gap-4 px-8 md:px-12 py-5 md:py-6 bg-[#0077b5] text-white rounded-full font-bold text-lg md:text-xl hover:scale-105 transition-all shadow-xl">
                        <Linkedin size={24} md:size={28} /> LinkedIn Profile
                    </a>
                    <a href="https://github.com/speedrapide10" target="_blank" class="flex justify-center items-center gap-4 px-8 md:px-12 py-5 md:py-6 bg-zinc-900 dark:bg-zinc-100 dark:text-zinc-900 text-white rounded-full font-bold text-lg md:text-xl hover:scale-105 transition-all shadow-xl">
                        <Github size={24} md:size={28} /> GitHub Repositories
                    </a>
                </div>
            </div>
        </section>
    </main>
</Layout>

<script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    // STABILITY FIX: Fast snappy reveal (0.7s) with explicit autoAlpha
    gsap.fromTo(".hero-name-1", 
        { y: 80, autoAlpha: 0 }, 
        { y: 0, autoAlpha: 1, duration: 0.8, ease: "power4.out", delay: 2.8 }
    );
    gsap.fromTo(".hero-name-2", 
        { y: 80, autoAlpha: 0 }, 
        { y: 0, autoAlpha: 0.5, duration: 0.8, ease: "power4.out", delay: 3.0 }
    );

    gsap.from(".reveal-content", { 
        scrollTrigger: { trigger: ".reveal-content", start: "top 95%" }, 
        y: 40, autoAlpha: 0, duration: 1, stagger: 0.2, ease: "power2.out" 
    });
</script>