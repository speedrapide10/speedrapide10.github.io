---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Cursor from '../components/Cursor.astro';
import LoadingScreen from '../components/LoadingScreen.astro';
import BackToTop from '../components/BackToTop.astro';
import Mascot from '../components/Mascot.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = "Oussama Karem - SysOps Engineer N2 Cloud specialized in Linux ecosystem, Infrastructure as Code, Automation, and Virtualization.",
  ogImage = "/favicon.svg"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://speedrapide10.github.io');
---

<!doctype html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="canonical" href={canonicalURL} />

        <!-- Primary Meta Tags -->
        <title>{title}</title>
        <meta name="title" content={title} />
        <meta name="description" content={description} />
        <meta name="author" content="Oussama Karem" />

        <!-- Open Graph / Facebook / LinkedIn -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={new URL(ogImage, canonicalURL)} />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={canonicalURL} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={new URL(ogImage, canonicalURL)} />

        <script is:inline>
            const getTheme = () => {
                if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
                    return localStorage.getItem('theme');
                }
                return 'system';
            };
            const applyTheme = (theme) => {
                const root = document.documentElement;
                root.classList.remove('light', 'dark');
                if (theme === 'dark') root.classList.add('dark');
                if (theme === 'light') root.classList.add('light');
            };
            applyTheme(getTheme());
        </script>
    </head>
    <body class="antialiased selection:bg-blue-500/30 overflow-x-hidden text-foreground transition-colors duration-300">
        <LoadingScreen />
        <Header />
        <Cursor />
        <BackToTop />
        <Mascot />

        <div class="content-wrapper opacity-0">
            <slot />
        </div>

        <script>
            import gsap from 'gsap';
            window.addEventListener('load', () => {
                gsap.to(".content-wrapper", {
                    opacity: 1,
                    duration: 1,
                    delay: 2.6,
                    ease: "power2.out"
                });
            });
        </script>
    </body>
</html>
