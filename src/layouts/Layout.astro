---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Cursor from '../components/Cursor.astro';
import LoadingScreen from '../components/LoadingScreen.astro';
import BackToTop from '../components/BackToTop.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet">
	</head>
	<body class="antialiased selection:bg-blue-500/30 overflow-x-hidden bg-background text-foreground transition-colors duration-300">
		<LoadingScreen />
		<Header />
		<Cursor />
		<BackToTop />

		<div class="content-wrapper opacity-0">
			<slot />
		</div>

		<script>
			import gsap from 'gsap';
			window.addEventListener('load', () => {
				gsap.to(".content-wrapper", { 
					opacity: 1, 
					duration: 1.2, 
					delay: 2.5, 
					ease: "power2.out" 
				});
			});
		</script>
	</body>
</html>