---
import { Linkedin, Github, Mail } from 'lucide-react';

const CONTACT_EMAIL = "karemoussama10+pro@gmail.com";
---

<section id="connect" class="pt-10 pb-20 md:pt-40 reveal-content scroll-mt-32">
    <div class="max-w-4xl mx-auto text-center space-y-8 md:space-y-12 pb-20">
        <h2 class="text-4xl md:text-7xl font-black uppercase tracking-tighter visible-primary">Scale with confidence.</h2>
        <p class="text-xl md:text-2xl visible-secondary leading-relaxed px-4">
            Explore my full professional experience, code contributions, or reach out directly.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4 sm:gap-6 pt-8 px-6 pb-12 flex-wrap items-center">
            <a href={`mailto:${CONTACT_EMAIL}`} class="flex justify-center items-center gap-3 px-7 md:px-10 py-4 md:py-5 bg-blue-600 dark:bg-sky-500 text-white dark:text-slate-950 rounded-full font-bold text-base md:text-lg hover:scale-105 transition-all shadow-xl shadow-blue-500/25">
                <Mail size={22} /> Get In Touch
            </a>
            <a href="https://linkedin.com/in/oussama-karem" target="_blank" class="flex justify-center items-center gap-3 px-7 md:px-10 py-4 md:py-5 bg-[#0077b5] text-white rounded-full font-bold text-base md:text-lg hover:scale-105 transition-all shadow-xl">
                <Linkedin size={22} /> LinkedIn Profile
            </a>
            <a href="https://github.com/speedrapide10" target="_blank" class="flex justify-center items-center gap-3 px-7 md:px-10 py-4 md:py-5 bg-zinc-900 dark:bg-zinc-100 dark:text-zinc-900 text-white rounded-full font-bold text-base md:text-lg hover:scale-105 transition-all shadow-xl">
                <Github size={22} /> GitHub Repositories
            </a>
        </div>
    </div>
</section>
