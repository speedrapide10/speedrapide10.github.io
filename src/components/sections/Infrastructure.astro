---
import { Github, Workflow, Box, Cloud, Server, ArrowRight, Bell } from 'lucide-react';
---

<section id="infrastructure" class="pt-8 pb-16 md:pt-10 md:pb-32 border-t border-zinc-500/20 dark:border-white/10 reveal-content scroll-mt-28 md:scroll-mt-32">
    <h2 class="text-[10px] sm:text-xs md:text-sm font-bold tracking-[0.2em] sm:tracking-[0.4em] md:tracking-[0.6em] uppercase opacity-60 mb-6 md:mb-12 italic visible-primary break-words max-w-full">
        / Hosting_Infrastructure_&_Pipeline
    </h2>
    
    <div class="glass-card rounded-2xl md:rounded-[2.5rem] p-4 sm:p-8 md:p-10 relative overflow-hidden space-y-8 md:space-y-10">
        <!-- Colored Top Accent Line -->
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-blue-500 via-purple-500 to-emerald-500"></div>

        <!-- Header Row -->
        <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-6 pb-6 border-b border-zinc-500/20">
            <div>
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 mb-3">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span class="text-[10px] md:text-xs font-mono font-bold text-emerald-400 uppercase tracking-wider">Production Architecture • Edge Hosting</span>
                </div>
                <h3 class="text-xl sm:text-2xl md:text-4xl font-black uppercase tracking-tight visible-primary">Portfolio Hosting Stack</h3>
                <p class="text-xs sm:text-sm md:text-base visible-secondary max-w-2xl mt-2 leading-relaxed">
                    Automated with modern GitOps workflows, tested inside Docker containers, protected at the edge by Cloudflare, and backed by extensive experience in <strong>Self-Hosting</strong>, <strong>Disaster Recovery</strong>, and <strong>Automated Observability</strong>.
                </p>
            </div>

            <!-- Self-Hosting & Automation Highlight Badge -->
            <div class="p-4 rounded-xl bg-blue-500/10 border border-blue-500/20 max-w-full lg:max-w-sm space-y-1.5 w-full lg:w-auto">
                <div class="flex items-center gap-2 text-blue-400 font-bold text-xs md:text-sm uppercase tracking-wider">
                    <Server class="w-4 h-4 text-blue-400 shrink-0" /> Self-Hosting & DR Automation
                </div>
                <p class="text-xs visible-secondary leading-normal">
                    Orchestrating Proxmox/oVirt clusters, Portainer stacks, self-hosted Forgejo Git, zero-touch disaster recovery scripts, and embedded Mattermost webhook notifications.
                </p>
            </div>
        </div>

        <!-- Visual Flow Diagram with Connecting Arrows -->
        <div class="space-y-4">
            <p class="text-[10px] sm:text-xs font-mono font-bold uppercase tracking-widest opacity-60 text-blue-400">/ Automated_CI-CD_Deployment_Flow</p>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 relative">
                <!-- Node 1: GitHub -->
                <div class="p-4 sm:p-5 rounded-xl bg-zinc-900/60 border border-zinc-800 flex flex-col items-center text-center space-y-3 relative group hover:border-blue-500/50 transition-all">
                    <div class="p-3 bg-zinc-800/80 rounded-lg text-white">
                        <Github class="w-6 h-6 md:w-7 md:h-7" />
                    </div>
                    <div>
                        <span class="text-[10px] font-mono text-blue-400 font-bold uppercase">01. Version Control</span>
                        <h4 class="font-bold text-sm text-foreground uppercase mt-0.5">GitHub & Forgejo</h4>
                        <p class="text-[11px] visible-secondary mt-1">GitOps source code & self-hosted VCS backup</p>
                    </div>
                    <!-- Desktop Flow Arrow -->
                    <div class="hidden lg:flex absolute -right-3 top-1/2 -translate-y-1/2 z-10 p-1 rounded-full bg-zinc-900 border border-zinc-700 text-blue-400 shadow-md">
                        <ArrowRight class="w-3.5 h-3.5" />
                    </div>
                </div>

                <!-- Node 2: GitHub Actions -->
                <div class="p-4 sm:p-5 rounded-xl bg-zinc-900/60 border border-zinc-800 flex flex-col items-center text-center space-y-3 relative group hover:border-blue-500/50 transition-all">
                    <div class="p-3 bg-blue-500/10 rounded-lg text-blue-400">
                        <Workflow class="w-6 h-6 md:w-7 md:h-7" />
                    </div>
                    <div>
                        <span class="text-[10px] font-mono text-blue-400 font-bold uppercase">02. Automation</span>
                        <h4 class="font-bold text-sm text-foreground uppercase mt-0.5">GitHub Actions</h4>
                        <p class="text-[11px] visible-secondary mt-1">Automated linting, Astro build & test verification</p>
                    </div>
                    <!-- Desktop Flow Arrow -->
                    <div class="hidden lg:flex absolute -right-3 top-1/2 -translate-y-1/2 z-10 p-1 rounded-full bg-zinc-900 border border-zinc-700 text-cyan-400 shadow-md">
                        <ArrowRight class="w-3.5 h-3.5" />
                    </div>
                </div>

                <!-- Node 3: Docker -->
                <div class="p-4 sm:p-5 rounded-xl bg-zinc-900/60 border border-zinc-800 flex flex-col items-center text-center space-y-3 relative group hover:border-cyan-500/50 transition-all">
                    <div class="p-3 bg-cyan-500/10 rounded-lg text-cyan-400">
                        <Box class="w-6 h-6 md:w-7 md:h-7" />
                    </div>
                    <div>
                        <span class="text-[10px] font-mono text-cyan-400 font-bold uppercase">03. Containerization</span>
                        <h4 class="font-bold text-sm text-foreground uppercase mt-0.5">Docker Container</h4>
                        <p class="text-[11px] visible-secondary mt-1">Portainer managed multi-stage Nginx build</p>
                    </div>
                    <!-- Desktop Flow Arrow -->
                    <div class="hidden lg:flex absolute -right-3 top-1/2 -translate-y-1/2 z-10 p-1 rounded-full bg-zinc-900 border border-zinc-700 text-orange-400 shadow-md">
                        <ArrowRight class="w-3.5 h-3.5" />
                    </div>
                </div>

                <!-- Node 4: Cloudflare Edge -->
                <div class="p-4 sm:p-5 rounded-xl bg-zinc-900/60 border border-zinc-800 flex flex-col items-center text-center space-y-3 relative group hover:border-orange-500/50 transition-all">
                    <div class="p-3 bg-orange-500/10 rounded-lg text-orange-400">
                        <Cloud class="w-6 h-6 md:w-7 md:h-7" />
                    </div>
                    <div>
                        <span class="text-[10px] font-mono text-orange-400 font-bold uppercase">04. Edge Hosting</span>
                        <h4 class="font-bold text-sm text-foreground uppercase mt-0.5">Cloudflare Pages</h4>
                        <p class="text-[11px] visible-secondary mt-1">Global Edge CDN, TLS 1.3 & WAF Protection</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Metrics & Telemetry Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 md:gap-4 pt-4 border-t border-zinc-500/20">
            <div class="p-3.5 md:p-4 rounded-xl bg-zinc-900/40 border border-zinc-800 text-center">
                <span class="text-[9px] md:text-[10px] font-mono text-zinc-400 uppercase tracking-wider block">Disaster Recovery</span>
                <span class="text-xs md:text-sm font-bold text-purple-400 mt-0.5 block">Forgejo Git Backups</span>
            </div>

            <div class="p-3.5 md:p-4 rounded-xl bg-zinc-900/40 border border-zinc-800 text-center">
                <span class="text-[9px] md:text-[10px] font-mono text-zinc-400 uppercase tracking-wider block">Observability</span>
                <span class="text-xs md:text-sm font-bold text-blue-400 mt-0.5 block">Mattermost Alerts</span>
            </div>

            <div class="p-3.5 md:p-4 rounded-xl bg-zinc-900/40 border border-zinc-800 text-center">
                <span class="text-[9px] md:text-[10px] font-mono text-zinc-400 uppercase tracking-wider block">Edge Security</span>
                <span class="text-xs md:text-sm font-bold text-amber-400 mt-0.5 block">Cloudflare WAF</span>
            </div>

            <div class="p-3.5 md:p-4 rounded-xl bg-zinc-900/40 border border-zinc-800 text-center">
                <span class="text-[9px] md:text-[10px] font-mono text-zinc-400 uppercase tracking-wider block">Infrastructure SLA</span>
                <span class="text-xs md:text-sm font-bold text-emerald-400 mt-0.5 block">99.99% Availability</span>
            </div>
        </div>
    </div>
</section>
