---
import { Cpu, Terminal, Box, FileDown, Linkedin, Github } from 'lucide-react';

const RESUME_PATH = "/cv.pdf"; 
const LINKEDIN_URL = "https://linkedin.com/in/oussama-karem";
const CV_LINK = RESUME_PATH ? RESUME_PATH : LINKEDIN_URL;
---

<section class="min-h-[75vh] lg:min-h-[82vh] xl:min-h-[90vh] flex flex-col justify-center items-start pt-2 lg:pt-0">
    <div class="reveal-hero w-full">
        <!-- Live Status Pill -->
        <div class="inline-flex items-center gap-2 px-3 py-1 lg:px-3.5 lg:py-1 rounded-full bg-blue-500/10 border border-blue-500/20 mb-3 lg:mb-4">
            <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span class="text-[10px] sm:text-xs font-mono font-bold tracking-wider text-blue-400 uppercase">
                Systems Operational • Available for Roles
            </span>
        </div>

        <p class="font-mono text-blue-600 dark:text-blue-400 text-xs sm:text-sm lg:text-sm tracking-[0.25em] lg:tracking-[0.4em] uppercase font-bold mb-3 lg:mb-4">
            SysOps Engineer
        </p>

        <!-- Clamped Hero Titles for 125% Display Scale Safety -->
        <div class="relative min-h-[80px] sm:min-h-[100px] lg:min-h-[120px] xl:min-h-0">
            <h1 class="text-4xl sm:text-6xl lg:text-6xl xl:text-[8rem] 2xl:text-[10rem] font-black tracking-tighter leading-[0.75] uppercase select-none text-foreground opacity-0 hero-name-1">
                OUSSAMA
            </h1>
            <h1 class="text-4xl sm:text-6xl lg:text-6xl xl:text-[8rem] 2xl:text-[10rem] font-black leading-[0.75] uppercase text-transparent outline-name opacity-0 hover:opacity-100 transition-all duration-1000 cursor-default lg:ml-4 xl:ml-8 mt-1 lg:mt-1.5 hero-name-2">
                KAREM
            </h1>
        </div>
        
        <div class="mt-6 lg:mt-8 xl:mt-12 flex flex-wrap gap-x-6 lg:gap-x-8 xl:gap-x-14 gap-y-2.5 lg:gap-y-4 font-mono text-[11px] sm:text-xs lg:text-xs xl:text-sm uppercase tracking-widest">
            <span class="flex items-center gap-2 lg:gap-3 font-bold visible-primary border-l-4 border-blue-500 pl-2.5 lg:pl-4"><Cpu class="w-4 h-4" client:load /> Linux Specialist</span>
            <span class="flex items-center gap-2 lg:gap-3 font-bold visible-primary border-l-4 border-zinc-700 pl-2.5 lg:pl-4"><Terminal class="w-4 h-4" client:load /> IaC & Automation</span>
            <span class="flex items-center gap-2 lg:gap-3 font-bold visible-primary border-l-4 border-zinc-700 pl-2.5 lg:pl-4"><Box class="w-4 h-4" client:load /> Virtualization Specialist</span>
        </div>

        <div class="mt-6 lg:mt-8 xl:mt-12 flex flex-col sm:flex-row gap-3 lg:gap-4">
            <a href={CV_LINK} target="_blank" class="flex justify-center items-center gap-2.5 px-5 py-2.5 lg:px-7 lg:py-3.5 bg-blue-600 text-white rounded-xl font-bold text-xs lg:text-sm hover:scale-105 transition-all shadow-xl shadow-blue-600/20">
                <FileDown size={16} /> Download CV
            </a>
            <div class="flex gap-2.5 lg:gap-3">
                <a href="https://linkedin.com/in/oussama-karem" target="_blank" class="flex-1 flex justify-center items-center gap-2 px-4 py-2.5 lg:px-5 lg:py-3.5 bg-[#0077b5] text-white rounded-xl font-bold text-xs lg:text-sm hover:scale-105 transition-all">
                    <Linkedin size={16} /> LinkedIn
                </a>
                <a href="https://github.com/speedrapide10" target="_blank" class="flex-1 flex justify-center items-center gap-2 px-4 py-2.5 lg:px-5 lg:py-3.5 bg-zinc-900 dark:bg-zinc-100 dark:text-zinc-900 text-white rounded-xl font-bold text-xs lg:text-sm hover:scale-105 transition-all">
                    <Github size={16} /> GitHub
                </a>
            </div>
        </div>
    </div>
</section>
