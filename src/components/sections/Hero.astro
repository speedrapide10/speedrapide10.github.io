---
import { Cpu, Terminal as TermIcon, Box, FileDown, Linkedin, Github } from 'lucide-react';
import TerminalWidget from '../TerminalWidget.astro';

const RESUME_PATH = "/cv.pdf"; 
const LINKEDIN_URL = "https://linkedin.com/in/oussama-karem";
const CV_LINK = RESUME_PATH ? RESUME_PATH : LINKEDIN_URL;
---

<!-- Calibrated top padding (pt-20 sm:pt-24 lg:pt-28) reduces top whitespace while guaranteeing zero header collision across scales -->
<section class="min-h-[85vh] lg:min-h-[90vh] flex flex-col justify-center items-start pt-20 sm:pt-24 lg:pt-28 pb-8">
    <div class="reveal-hero w-full">
        <!-- Live Status Pills -->
        <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-3 mb-3 lg:mb-4 max-w-full">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 dark:bg-sky-400/10 border border-blue-500/30 dark:border-sky-400/30 max-w-full">
                <span class="relative flex h-2 w-2 shrink-0">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                </span>
                <span class="text-[10px] sm:text-xs font-mono font-bold tracking-wider text-blue-700 dark:text-sky-300 uppercase truncate">
                    Systems Operational • Available for Roles & Freelance
                </span>
            </div>

            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-300/60 dark:bg-slate-800/80 border border-slate-400/30 dark:border-slate-700 text-[10px] sm:text-xs font-mono font-bold text-slate-800 dark:text-slate-200 shrink-0 w-max max-w-full">
                📍 UTC+1 • Salé, Morocco
            </div>
        </div>

        <p class="font-mono text-blue-700 dark:text-sky-400 text-xs sm:text-sm lg:text-sm tracking-[0.25em] lg:tracking-[0.4em] uppercase font-bold mb-3 lg:mb-4">
            SysOps Engineer
        </p>

        <div class="relative min-h-[80px] sm:min-h-[100px] lg:min-h-[120px] xl:min-h-0">
            <h1 class="text-4xl sm:text-6xl lg:text-6xl xl:text-[8rem] 2xl:text-[10rem] font-black tracking-tighter leading-[0.75] uppercase select-none text-slate-900 dark:text-slate-100 opacity-0 hero-name-1">
                OUSSAMA
            </h1>
            <h1 class="text-4xl sm:text-6xl lg:text-6xl xl:text-[8rem] 2xl:text-[10rem] font-black leading-[0.75] uppercase text-transparent outline-name opacity-0 hover:opacity-100 transition-all duration-1000 cursor-default lg:ml-4 xl:ml-8 mt-1 lg:mt-1.5 hero-name-2">
                KAREM
            </h1>
        </div>
        
        <div class="mt-6 lg:mt-8 flex flex-wrap gap-x-6 lg:gap-x-8 xl:gap-x-14 gap-y-2.5 lg:gap-y-4 font-mono text-[11px] sm:text-xs lg:text-xs xl:text-sm uppercase tracking-widest">
            <span class="flex items-center gap-2 lg:gap-3 font-bold text-slate-900 dark:text-slate-100 border-l-4 border-blue-500 dark:border-sky-400 pl-2.5 lg:pl-4"><Cpu class="w-4 h-4 text-blue-600 dark:text-sky-400" client:load /> Linux Specialist</span>
            <span class="flex items-center gap-2 lg:gap-3 font-bold text-slate-900 dark:text-slate-100 border-l-4 border-slate-400 dark:border-slate-700 pl-2.5 lg:pl-4"><TermIcon class="w-4 h-4 text-slate-700 dark:text-slate-300" client:load /> IaC & Automation</span>
            <span class="flex items-center gap-2 lg:gap-3 font-bold text-slate-900 dark:text-slate-100 border-l-4 border-slate-400 dark:border-slate-700 pl-2.5 lg:pl-4"><Box class="w-4 h-4 text-slate-700 dark:text-slate-300" client:load /> Virtualization Specialist</span>
        </div>

        <!-- Action Buttons -->
        <div class="mt-6 lg:mt-8 flex flex-col sm:flex-row gap-3 lg:gap-4">
            <a href={CV_LINK} target="_blank" class="flex justify-center items-center gap-2.5 px-5 py-2.5 lg:px-7 lg:py-3.5 bg-blue-600 dark:bg-sky-500 text-white dark:text-slate-950 rounded-xl font-bold text-xs lg:text-sm hover:scale-105 transition-all shadow-xl shadow-blue-600/20">
                <FileDown size={16} /> Download CV
            </a>
            <div class="flex gap-2.5 lg:gap-3">
                <a href="https://linkedin.com/in/oussama-karem" target="_blank" class="flex-1 flex justify-center items-center gap-2 px-4 py-2.5 lg:px-5 lg:py-3.5 bg-[#0077b5] text-white rounded-xl font-bold text-xs lg:text-sm hover:scale-105 transition-all">
                    <Linkedin size={16} /> LinkedIn
                </a>
                <a href="https://github.com/speedrapide10" target="_blank" class="flex-1 flex justify-center items-center gap-2 px-4 py-2.5 lg:px-5 lg:py-3.5 bg-slate-900 dark:bg-slate-100 dark:text-slate-900 text-white rounded-xl font-bold text-xs lg:text-sm hover:scale-105 transition-all">
                    <Github size={16} /> GitHub
                </a>
            </div>
        </div>

        <TerminalWidget />
    </div>
</section>
