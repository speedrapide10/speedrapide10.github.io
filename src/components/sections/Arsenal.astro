---
import { skillCategories } from '../../data/skills';
import { Terminal, Cpu, Activity, Layers, Network, Shield } from 'lucide-react';

const iconMap: Record<string, any> = {
  Terminal,
  Cpu,
  Activity,
  Layers,
  Network,
  Shield
};

const iconColorMap: Record<string, string> = {
  'text-blue-500': 'text-blue-700 dark:text-sky-400',
  'text-orange-500': 'text-amber-700 dark:text-amber-300',
  'text-green-500': 'text-emerald-700 dark:text-emerald-300',
  'text-zinc-500 dark:text-zinc-400': 'text-slate-700 dark:text-slate-300',
  'text-purple-500': 'text-purple-700 dark:text-purple-300',
  'text-red-500': 'text-rose-700 dark:text-rose-300'
};
---

<section id="arsenal" class="pt-10 pb-24 md:pt-10 md:pb-32 border-t border-slate-300/40 dark:border-slate-800 reveal-content scroll-mt-32">
    <h2 class="text-xs md:text-sm font-mono font-extrabold tracking-[0.3em] uppercase text-blue-700 dark:text-sky-400 mb-12 md:mb-16 italic">
        / Technical_Arsenal
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-12 pb-10">
        {skillCategories.map((skill) => {
            const IconComponent = iconMap[skill.icon];
            const iconColor = iconColorMap[skill.color] || 'text-blue-700 dark:text-sky-400';
            return (
                <div class="p-8 md:p-10 glass-card rounded-3xl space-y-4 md:space-y-6">
                    <div class="flex items-center gap-4">
                        {IconComponent && <div class={iconColor}><IconComponent size={22} /></div>}
                        <h3 class="font-bold uppercase tracking-widest text-xs md:text-sm text-slate-900 dark:text-slate-100">{skill.title}</h3>
                    </div>
                    <p class="text-sm text-slate-700 dark:text-slate-200 leading-relaxed font-medium">{skill.description}</p>
                </div>
            );
        })}
    </div>
</section>
