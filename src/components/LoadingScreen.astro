---
---
<div id="loader" class="fixed inset-0 z-[10000] bg-[#e4e4e7] dark:bg-[#09090b] flex flex-col items-center justify-center overflow-hidden transition-colors duration-300">
    <div class="mb-8 text-6xl animate-bounce">🐧</div>
    
    <div class="text-center mb-10">
        <h2 class="text-2xl md:text-3xl font-black tracking-tighter uppercase text-zinc-800 dark:text-zinc-200">
            Oussama Karem
        </h2>
        <p class="text-xs font-mono tracking-[0.3em] uppercase opacity-50 mt-2 text-zinc-600 dark:text-zinc-400">
            Preparing Portfolio
        </p>
    </div>

    <div class="relative w-72 md:w-96 h-1 bg-zinc-300 dark:bg-zinc-800 rounded-full overflow-hidden">
        <div id="loader-bar" class="absolute top-0 left-0 h-full w-0 bg-blue-600 dark:bg-blue-500 shadow-[0_0_20px_rgba(59,130,246,0.3)] transition-all ease-out"></div>
    </div>
    
    <div class="mt-4 font-mono text-sm font-bold text-zinc-500">
        <span id="loader-percent">0</span>%
    </div>
</div>

<script>
    import gsap from 'gsap';
    const tl = gsap.timeline();
    const percentEl = document.getElementById('loader-percent');
    const barEl = document.getElementById('loader-bar');
    const loaderEl = document.getElementById('loader');

    // Prevent scrolling during intro
    document.body.style.overflow = 'hidden';

    const counter = { val: 0 };
    tl.to(counter, {
        val: 100,
        duration: 2.2,
        ease: "power2.inOut",
        onUpdate: () => {
            if (percentEl) percentEl.innerText = Math.floor(counter.val).toString();
            if (barEl) barEl.style.width = `${counter.val}%`;
        }
    });

    // Elegant Fade Out
    tl.to(loaderEl, {
        opacity: 0,
        scale: 1.05,
        duration: 0.8,
        ease: "power2.inOut",
        onComplete: () => {
            // SCROLLBAR FIX: Clear the inline style so CSS takes over (overflow-x: hidden)
            document.body.style.overflow = '';
            if (loaderEl) loaderEl.style.display = 'none';
        }
    });
</script>