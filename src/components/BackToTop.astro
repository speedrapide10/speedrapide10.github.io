---
import { ChevronUp } from 'lucide-react';
---

<button 
    id="back-to-top" 
    class="fixed bottom-3 right-3 md:bottom-6 md:right-6 xl:right-10 z-[80] w-9 h-11 md:w-12 md:h-16 xl:w-14 xl:h-18 bg-zinc-200/90 dark:bg-zinc-800/90 backdrop-blur-md border border-zinc-400/40 dark:border-white/20 rounded-full flex flex-col items-center justify-center shadow-2xl opacity-0 invisible hover:scale-110 hover:border-blue-500 transition-all cursor-pointer group"
    aria-label="Back to Top"
>
    <div class="flex flex-col items-center -space-y-2 md:-space-y-3 mb-0.5">
        <ChevronUp class="w-3.5 h-3.5 md:w-5 md:h-5 arrow-icon text-blue-600 dark:text-sky-400" />
        <ChevronUp class="w-3.5 h-3.5 md:w-5 md:h-5 arrow-icon text-blue-600/50 dark:text-sky-400/50" />
    </div>
</button>

<script>
    import gsap from 'gsap';
    const btn = document.getElementById('back-to-top');

    gsap.to(".arrow-icon", {
        y: -3,
        duration: 0.8,
        repeat: -1,
        yoyo: true,
        stagger: 0.2,
        ease: "power1.inOut"
    });

    window.addEventListener('scroll', () => {
        if (window.scrollY > 400) {
            gsap.to(btn, { opacity: 1, visibility: 'visible', duration: 0.3, ease: "power2.out" });
        } else {
            gsap.to(btn, { opacity: 0, visibility: 'hidden', duration: 0.3, ease: "power2.in" });
        }
    });

    btn?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
    });
</script>
