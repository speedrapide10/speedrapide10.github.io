---
import { ChevronUp } from 'lucide-react';
---
<button 
    id="back-to-top" 
    class="fixed bottom-10 right-10 z-[50] w-16 h-20 bg-zinc-200 dark:bg-zinc-800 border-2 border-zinc-400/40 dark:border-white/20 rounded-full flex flex-col items-center justify-center shadow-2xl opacity-0 invisible hover:scale-110 hover:border-blue-500 transition-all cursor-pointer group"
    aria-label="Back to Top"
>
    <div class="flex flex-col items-center -space-y-3 mb-1">
        <ChevronUp size={20} class="arrow-icon text-blue-600 dark:text-blue-400" />
        <ChevronUp size={20} class="arrow-icon text-blue-600/50 dark:text-blue-400/50" />
    </div>
    
    <span class="text-2xl">🐧</span>
</button>

<script>
    import gsap from 'gsap';

    const btn = document.getElementById('back-to-top');

    // Continuous staggered arrow animation
    gsap.to(".arrow-icon", {
        y: -4,
        duration: 0.8,
        repeat: -1,
        yoyo: true,
        stagger: 0.2,
        ease: "power1.inOut"
    });

    // Scroll visibility logic
    window.addEventListener('scroll', () => {
        if (window.scrollY > 500) {
            gsap.to(btn, { opacity: 1, visibility: 'visible', duration: 0.4, ease: "power2.out" });
        } else {
            gsap.to(btn, { opacity: 0, visibility: 'hidden', duration: 0.4, ease: "power2.in" });
        }
    });

    // Smooth scroll to top
    btn?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
    });
</script>