---
/**
 * FRIENDLY SYSOPS SIDEKICK:
 * - Height-clamped for 125% scaled screens to clear fixed elements.
 * - Retains 5-click Overclock Easter Egg and center-origin spin.
 */
---

<div id="mascot-wrapper" class="fixed bottom-4 right-12 lg:bottom-6 lg:right-16 xl:right-28 z-[40] pointer-events-auto select-none hidden md:block transition-all duration-500 cursor-pointer origin-bottom-right group">
    <!-- High-Contrast Speech Bubble -->
    <div id="welcome-bubble" class="absolute right-0 -top-28 lg:-top-32 bg-zinc-900/95 border-2 border-blue-500 p-3 lg:p-4 rounded-2xl rounded-br-none shadow-[0_10px_30px_rgba(0,0,0,0.8)] opacity-0 scale-50 transition-all duration-300 pointer-events-none origin-bottom-right w-60 lg:w-72 xl:w-80 backdrop-blur-xl z-[120]">
        <p id="bubble-text" class="text-xs lg:text-sm font-bold text-zinc-100 leading-relaxed">
            Hi! I'm Oussama's Cloud-Bot. <br/>
            <span class="text-blue-400 font-extrabold animate-pulse inline-block mt-0.5">Click me for a magic trick! ⚡</span>
        </p>
    </div>

    <!-- Scaled Mascot Container -->
    <div id="bot-container" class="w-20 h-20 lg:w-24 lg:h-24 xl:w-32 xl:h-32 transition-transform animate-float">
        <svg viewBox="0 0 120 120" class="w-full h-full drop-shadow-2xl overflow-visible" id="bot-svg">
            <rect x="25" y="40" width="70" height="60" rx="30" class="fill-white dark:fill-zinc-800 stroke-blue-500 transition-colors duration-300" stroke-width="3" />
            <circle id="bot-antenna" cx="60" cy="30" r="8" class="fill-blue-500 animate-pulse" />
            <line x1="60" y1="38" x2="60" y2="42" stroke="#3b82f6" stroke-width="3" />
            <g id="bot-face">
                <circle cx="45" cy="70" r="10" fill="#e4e4e7" class="dark:fill-zinc-900" />
                <circle id="left-pupil" cx="45" cy="70" r="4" fill="#3b82f6" />
                <circle cx="75" cy="70" r="10" fill="#e4e4e7" class="dark:fill-zinc-900" />
                <circle id="right-pupil" cx="75" cy="70" r="4" fill="#3b82f6" />
            </g>
            <path d="M50 85 Q60 92 70 85" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" />
        </svg>
    </div>
</div>

<style>
    @keyframes float {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-8px); }
    }
    .animate-float {
        animation: float 4s ease-in-out infinite;
    }
</style>

<script>
    import gsap from 'gsap';

    const wrapper = document.getElementById('mascot-wrapper');
    const bubble = document.getElementById('welcome-bubble');
    const bubbleText = document.getElementById('bubble-text');
    const leftPupil = document.getElementById('left-pupil');
    const rightPupil = document.getElementById('right-pupil');
    const svg = document.getElementById('bot-svg');
    const antenna = document.getElementById('bot-antenna');

    let isSmall = false;

    const shrinkMascot = () => {
        if (isSmall || !wrapper) return;
        isSmall = true;
        gsap.to(wrapper, {
            scale: 0.8,
            duration: 0.8,
            ease: "power2.inOut"
        });
        if (bubble) gsap.to(bubble, { opacity: 0, scale: 0.5, duration: 0.3 });
    };

    window.addEventListener('load', () => {
        setTimeout(() => {
            if (bubble) gsap.to(bubble, { opacity: 1, scale: 1, duration: 0.5, ease: "back.out(1.7)" });
        }, 2800);

        setTimeout(() => shrinkMascot(), 10000);
    });

    window.addEventListener('scroll', () => {
        if (window.scrollY > 50) shrinkMascot();
    });

    let clickCount = 0;
    let clickResetTimer: NodeJS.Timeout;
    let isAnimating = false;

    wrapper?.addEventListener('click', () => {
        clickCount++;
        clearTimeout(clickResetTimer);

        clickResetTimer = setTimeout(() => {
            clickCount = 0;
        }, 1200);

        if (isAnimating) return;

        // Easter Egg: 5 Rapid Clicks
        if (clickCount >= 5) {
            isAnimating = true;
            clickCount = 0;

            if (bubbleText) {
                bubbleText.innerHTML = `<span class="text-amber-400 font-extrabold text-xs lg:text-sm italic uppercase tracking-widest animate-pulse">⚡ OVERCLOCK MODE ⚡</span><br/><span class="text-xs lg:text-sm font-bold text-amber-200 block mt-1">SYSTEM CPU @ 5.0GHz! AUTOMATION 10x! 🔥🚀</span>`;
            }

            const overclockTL = gsap.timeline({
                onComplete: () => { isAnimating = false; }
            });

            overclockTL
                .to(antenna, { fill: "#f59e0b", duration: 0.1, repeat: 10, yoyo: true })
                .to(svg, { 
                    rotation: "+=1080", 
                    scale: 1.2,
                    transformOrigin: "center center", 
                    duration: 1.2, 
                    ease: "elastic.out(1, 0.4)" 
                }, 0)
                .to(svg, { scale: 1, duration: 0.3 })
                .to(bubble, { opacity: 1, scale: 1, duration: 0.3 }, 0)
                .to(bubble, { opacity: 0, scale: 0.5, duration: 0.4, delay: 7 });

            return;
        }

        // Standard Click Messages
        isAnimating = true;
        const funMessages = [
            "Ansible Playbook: 0 failed, 100% in sync! 🚀",
            "Terraform Plan: 0 to destroy, clean state! 🟢",
            "Python script executed: Automation magic! ⚡",
            "Cluster Health: 99.99% Uptime rock solid! 💻",
            "Bash script saved 4 hours of manual labor! 🎉",
            "OS Hardening complete: Baselines enforced! 🔒"
        ];

        const randomMsg = funMessages[Math.floor(Math.random() * funMessages.length)];
        if (bubbleText) {
            bubbleText.innerHTML = `<span class="text-blue-400 font-extrabold text-[10px] lg:text-xs italic uppercase tracking-wider block mb-0.5">STATUS UPDATE:</span><span class="text-xs lg:text-sm font-bold text-zinc-100">${randomMsg}</span>`;
        }

        const clickTL = gsap.timeline({
            onComplete: () => { isAnimating = false; }
        });

        clickTL
            .to(antenna, { fill: "#60a5fa", duration: 0.1, repeat: 5, yoyo: true })
            .to(svg, { 
                rotation: "+=360", 
                transformOrigin: "center center", 
                duration: 0.8, 
                ease: "back.inOut" 
            }, 0)
            .to(bubble, { opacity: 1, scale: 1, duration: 0.3 }, 0)
            .to(bubble, { opacity: 0, scale: 0.5, duration: 0.4, delay: 6 });
    });

    window.addEventListener('mousemove', (e) => {
        if (!wrapper || !leftPupil || !rightPupil) return;
        const rect = wrapper.getBoundingClientRect();
        const botX = rect.left + rect.width / 2;
        const botY = rect.top + rect.height / 2;
        const angle = Math.atan2(e.clientY - botY, e.clientX - botX);
        const pupilDist = 3.5;
        gsap.to([leftPupil, rightPupil], { 
            x: Math.cos(angle) * pupilDist, 
            y: Math.sin(angle) * pupilDist, 
            duration: 0.3, 
            ease: "power1.out" 
        });
    });
</script>
