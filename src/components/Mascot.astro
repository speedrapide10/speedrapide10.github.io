---
/** * FRIENDLY SYSOPS SIDEKICK: 
 * - Invites users to click for fun effects.
 * - Shrinks after timeout/scroll.
 * - Random high-energy Infrastructure & Cloud messages with emojis (No 🌈).
 */
---
<div id="mascot-wrapper" class="fixed bottom-20 left-10 md:left-20 z-[40] pointer-events-auto select-none hidden md:block transition-all duration-700 cursor-pointer origin-bottom-left group">
    
    <div id="welcome-bubble" class="absolute -top-28 left-0 bg-white dark:bg-zinc-800 border-2 border-blue-500 p-4 rounded-2xl rounded-bl-none shadow-2xl opacity-0 scale-50 transition-all duration-500 pointer-events-none origin-bottom-left">
        <p id="bubble-text" class="text-sm font-bold text-zinc-800 dark:text-zinc-200 whitespace-nowrap leading-relaxed">
            Hi! I'm Oussama's Cloud-Bot. 🤖<br/>
            <span class="text-blue-500 animate-bounce inline-block mt-1">Click me for a magic trick! ✨</span>
        </p>
    </div>

    <div id="bot-container" class="w-48 h-48 md:w-56 md:h-56 transition-transform">
        <svg viewBox="0 0 120 120" class="w-full h-full drop-shadow-2xl" id="bot-svg">
            <rect x="25" y="40" width="70" height="60" rx="30" class="fill-white dark:fill-zinc-800 stroke-blue-500 transition-colors duration-300" stroke-width="3" />
            <circle id="bot-antenna" cx="60" cy="30" r="8" class="fill-blue-500 animate-pulse" />
            <line x1="60" y1="38" x2="60" y2="42" stroke="#3b82f6" stroke-width="3" />
            <g id="bot-face">
                <circle cx="45" cy="70" r="10" fill="#e4e4e7" class="dark:fill-zinc-900" />
                <circle id="left-pupil" cx="45" cy="70" r="4" fill="#3b82f6" />
                <circle cx="75" cy="70" r="10" fill="#e4e4e7" class="dark:fill-zinc-900" />
                <circle id="right-pupil" cx="75" cy="70" r="4" fill="#3b82f6" />
            </g>
            <path d="M50 85 Q60 92 70 85" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" />
        </svg>
    </div>
</div>

<script>
    import gsap from 'gsap';

    const wrapper = document.getElementById('mascot-wrapper');
    const bubble = document.getElementById('welcome-bubble');
    const bubbleText = document.getElementById('bubble-text');
    const leftPupil = document.getElementById('left-pupil');
    const rightPupil = document.getElementById('right-pupil');
    const svg = document.getElementById('bot-svg');
    const antenna = document.getElementById('bot-antenna');

    let isSmall = false;

    const shrinkMascot = () => {
        if (isSmall) return;
        isSmall = true;
        gsap.to(wrapper, {
            left: "2rem",
            bottom: "2rem",
            scale: 0.6,
            duration: 1.2,
            ease: "power3.inOut"
        });
        gsap.to(bubble, { opacity: 0, scale: 0.5, duration: 0.4 });
    };

    window.addEventListener('load', () => {
        const tl = gsap.timeline({ delay: 3 });
        tl.to(bubble, { opacity: 1, scale: 1, duration: 0.6, ease: "back.out(1.7)" });
        
        gsap.to(svg, {
            y: -20,
            scaleY: 1.02,
            duration: 2,
            repeat: -1,
            yoyo: true,
            ease: "sine.inOut"
        });

        setTimeout(shrinkMascot, 12000); 
    });

    window.addEventListener('scroll', () => {
        if (window.scrollY > 100) shrinkMascot();
    });

    wrapper?.addEventListener('click', () => {
        const funMessages = [
            "Infrastructure is feeling GREAT! ☁️✨",
            "Uptime is looking solid: 99.99%! 🚀",
            "Ansible just automated the coffee machine! ☕🦾",
            "Cloudflare is blocking the bad vibes! 🛡️✨",
            "Servers are patched and cozy! 🛌💻",
            "Terraform created a new planet today! 🌍🏗️",
            "Everything is scaling perfectly! 📈💎",
            "Deploying happiness to production! 🎈🔥"
        ];
        
        const randomMsg = funMessages[Math.floor(Math.random() * funMessages.length)];
        
        if (bubbleText) {
            bubbleText.innerHTML = `<span class="text-blue-500 font-black text-base italic">STATUS UPDATE:</span><br/><span class="text-base font-bold">${randomMsg}</span>`;
        }

        const clickTL = gsap.timeline();
        const bubbleScale = isSmall ? 1.7 : 1;
        const bubbleY = isSmall ? -40 : 0; 

        clickTL.to(antenna, { fill: "#60a5fa", duration: 0.1, repeat: 5, yoyo: true })
               .to(svg, { rotation: "+=360", scale: 1.2, duration: 0.8, ease: "back.inOut" }, 0)
               .to(svg, { scale: 1, duration: 0.3 })
               .to(bubble, { 
                    opacity: 1, 
                    scale: bubbleScale, 
                    y: bubbleY,
                    duration: 0.4 
                }, 0)
               .to(bubble, { opacity: 0, scale: 0.5, duration: 0.4, delay: 10 }); 
    });

    window.addEventListener('mousemove', (e) => {
        if (!wrapper || !leftPupil || !rightPupil) return;
        const rect = wrapper.getBoundingClientRect();
        const botX = rect.left + rect.width / 2;
        const botY = rect.top + rect.height / 2;
        const angle = Math.atan2(e.clientY - botY, e.clientX - botX);
        const pupilDist = 5;
        gsap.to([leftPupil, rightPupil], {
            x: Math.cos(angle) * pupilDist,
            y: Math.sin(angle) * pupilDist,
            duration: 0.8,
            ease: "power2.out"
        });
    });
</script>