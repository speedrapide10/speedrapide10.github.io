---
import { Terminal as TerminalIcon, Play, RefreshCw, CheckCircle2 } from 'lucide-react';
---

<div class="rounded-2xl border border-zinc-800 bg-zinc-950 overflow-hidden font-mono text-xs md:text-sm shadow-2xl my-8 text-zinc-200">
    <!-- Terminal Titlebar -->
    <div class="bg-zinc-900/90 px-4 py-3 flex items-center justify-between border-b border-zinc-800">
        <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-rose-500 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-amber-500 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-500 inline-block"></span>
            <span class="ml-2 text-[11px] font-bold text-zinc-400 flex items-center gap-1.5">
                <TerminalIcon size={14} class="text-blue-400" /> sysops@karem-node01:~
            </span>
        </div>
        <span class="text-[10px] text-zinc-500 uppercase tracking-widest hidden sm:inline-block">Interactive Shell</span>
    </div>

    <!-- Terminal Body -->
    <div class="p-4 sm:p-6 bg-zinc-950 text-zinc-200 min-h-[180px] max-h-[260px] overflow-y-auto space-y-3" id="terminal-body">
        <p class="text-zinc-400">Type <span class="text-blue-400 font-bold">'help'</span> to see available commands or click quick actions below.</p>
        <div id="terminal-history" class="space-y-2"></div>
        
        <form id="terminal-form" class="flex items-center gap-2 pt-1">
            <span class="text-emerald-400 font-bold">sysops@karem:~$</span>
            <input type="text" id="terminal-input" class="bg-transparent border-none outline-none text-blue-400 font-bold flex-1 caret-blue-400" focus autocomplete="off" placeholder="type command..." />
        </form>
    </div>

    <!-- Terminal Action Buttons -->
    <div class="p-3 bg-zinc-900/80 border-t border-zinc-800 flex flex-wrap gap-2">
        <button data-cmd="ansible-run" class="cmd-btn px-2.5 py-1 rounded bg-blue-500/10 hover:bg-blue-500/20 text-blue-300 border border-blue-500/30 text-[11px] font-bold transition-all flex items-center gap-1 cursor-pointer">
            <Play size={12} /> ansible-run
        </button>
        <button data-cmd="status" class="cmd-btn px-2.5 py-1 rounded bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 text-[11px] font-bold transition-all flex items-center gap-1 cursor-pointer">
            <CheckCircle2 size={12} /> status
        </button>
        <button data-cmd="clear" class="cmd-btn px-2.5 py-1 rounded bg-zinc-800 hover:bg-zinc-700 text-zinc-300 border border-zinc-700 text-[11px] font-bold transition-all flex items-center gap-1 cursor-pointer">
            <RefreshCw size={12} /> clear
        </button>
    </div>
</div>

<script>
    const form = document.getElementById('terminal-form');
    const input = document.getElementById('terminal-input') as HTMLInputElement;
    const history = document.getElementById('terminal-history');
    const cmdBtns = document.querySelectorAll('.cmd-btn');

    const commands: Record<string, string> = {
        'help': 'Available commands: <span class="text-blue-400 font-bold">status, certs, stack, ansible-run, freelance, clear</span>',
        'status': '<span class="text-emerald-400 font-bold">✓ Systems Operational</span> | Uptime: 99.99% | Edge Security: Active (Cloudflare WAF)',
        'certs': 'Red Hat RHCSA | Fortinet NSE | Scrum SFC | EF SET B2 Upper Intermediate',
        'stack': 'Linux (RHEL/Debian) | Ansible | Terraform | Proxmox | Docker | Portainer | Forgejo | Mattermost',
        'freelance': '<span class="text-purple-400 font-bold">Services Offered:</span> Infrastructure Audits, CI/CD Pipeline Automation, OS Hardening & Zero-Touch DR.',
        'ansible-run': '<span class="text-blue-400">[PLAYBOOK]</span> OS Hardening & Patching... <br/><span class="text-emerald-400">ok=12 changed=3 unreachable=0 failed=0</span>'
    };

    const runCommand = (cmd: string) => {
        const cleanCmd = cmd.trim().toLowerCase();
        if (!cleanCmd || !history) return;

        if (cleanCmd === 'clear') {
            history.innerHTML = '';
            if (input) input.value = '';
            return;
        }

        const userLine = document.createElement('div');
        userLine.className = 'flex items-center gap-2';
        userLine.innerHTML = `<span class="text-emerald-400 font-bold">sysops@karem:~$</span> <span class="font-bold text-zinc-100">${cleanCmd}</span>`;
        history.appendChild(userLine);

        const responseLine = document.createElement('div');
        responseLine.className = 'pl-4 text-xs leading-relaxed text-zinc-300';
        responseLine.innerHTML = commands[cleanCmd] || `<span class="text-rose-400">Command not found: '${cleanCmd}'. Type 'help' for available commands.</span>`;
        history.appendChild(responseLine);

        if (input) input.value = '';
        const body = document.getElementById('terminal-body');
        if (body) body.scrollTop = body.scrollHeight;
    };

    form?.addEventListener('submit', (e) => {
        e.preventDefault();
        if (input) runCommand(input.value);
    });

    cmdBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            const cmd = btn.getAttribute('data-cmd');
            if (cmd) runCommand(cmd);
        });
    });
</script>
